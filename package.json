{
  "name": "vxdicionario",
  "version": "2.0.1",
  "description": "Pacote para consultar informações do https://www.dicio.com.br/ e retornar em JSON.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vxdicionario": "bin/vxdicionario.js"
  },
  "files": [
    "dist",
    "types",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dicio",
    "dicionario",
    "portugues",
    "brasil",
    "vxdicionario"
  ],
  "author": {
    "name": "vitor_xp",
    "url": "https://vitorxp.squareweb.app/",
    "email": "vitorxp.contato@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorxcp/VxDicionario.git"
  },
  "bugs": {
    "url": "https://github.com/vitorxcp/VxDicionario/issues"
  },
  "homepage": "https://github.com/vitorxcp/VxDicionario#readme"
}
